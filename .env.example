# ============================================================================
#  8W社区 / 8W通行证系统 —— 环境变量示例
# ----------------------------------------------------------------------------
#  用法：cp .env.example .env  然后把占位值换成真实值
#  .env 已被 .gitignore 排除，永远不会进入版本库。
#  本文件只允许出现占位值，绝不允许出现任何真实密钥。
# ============================================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
# 新库名，不能与已废弃的旧库 bgjq 相同
DB_NAME=bgjq8w
DB_USER=bgjq8w
# 与 database/8w_passport.sql 里 __DB_PASSWORD__ 渲染出的值保持一致
DB_PASS=CHANGE_ME

# ---------- 8W通行证系统 ----------
PASSPORT_BASE_URL=https://8w.bgjq.top
PASSPORT_SESSION_TTL=86400
PASSPORT_OAUTH_CODE_TTL=300
PASSPORT_ACCESS_TTL=7200
PASSPORT_REFRESH_TTL=2592000
PASSPORT_COOKIE_NAME=w8_passport
PASSPORT_COOKIE_DOMAIN=
PASSPORT_ADMIN_ROLES=secretary_general
# 生产环境务必保持 0
PASSPORT_DEBUG=0
PASSPORT_DEV_BYPASS_VERIFICATION=0

# ---------- 权威数据接口：游戏内玩家（TODO）----------
PLAYER_API_BASE=
PLAYER_API_PATH=/player/{player}
PLAYER_API_TOKEN=
PLAYER_API_TIMEOUT=8
PLAYER_API_SUCCESS_FIELD=
PLAYER_API_NAME_FIELD=
PLAYER_API_ID_FIELD=
PLAYER_API_COUNTRY_FIELD=

# ---------- 权威数据接口：邦国（TODO）----------
COUNTRY_API_BASE=
COUNTRY_API_PATH=/country/{country_id}
COUNTRY_API_PATH_BY_NAME=
COUNTRY_API_TOKEN=
COUNTRY_API_TIMEOUT=8
COUNTRY_API_SUCCESS_FIELD=
COUNTRY_API_ID_FIELD=
COUNTRY_API_NAME_FIELD=
COUNTRY_API_DECLARATION_FIELD=
COUNTRY_API_TERRITORY_FIELD=
COUNTRY_API_PLAYERS_FIELD=
COUNTRY_API_PLAYER_NAME_FIELD=
COUNTRY_API_PLAYER_ID_FIELD=

DIRECTORY_CACHE_TTL=600

# ---------- 简幻通（TODO）----------
SIMPASS_API_URL=
SIMPPASS_ACCESS_TOKEN=
SIMPASS_API_TIMEOUT=8
SIMPASS_API_METHOD=POST
SIMPASS_API_SUCCESS_CODE=200
SIMPASS_API_CODE_FIELD=
SIMPASS_API_MESSAGE_FIELD=
SIMPASS_API_UID_FIELD=
SIMPASS_API_LEVEL_FIELD=
SIMPASS_API_PLAYER_FIELD=

# ---------- 邮箱验证码（可选绑定；TODO）----------
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_API_TIMEOUT=8
EMAIL_API_METHOD=POST
EMAIL_API_BODY_TEMPLATE=
EMAIL_API_SUCCESS_FIELD=
EMAIL_API_MESSAGE_FIELD=
EMAIL_CODE_TTL=600
EMAIL_FROM_NAME=8W通行证

# ---------- FanVerify 账号（可选绑定；已接入 fanverify.cn openAPI）----------
# 文档 https://doc.fanverify.cn/llms.txt
# 令牌在 FanVerify 开发者后台领取；官方 OpenAPI 文档里 servers 为空，
# 下面的根地址是实测得出的（/openapi/* 会返回文档描述的 401 结构）
# ⚠ FanVerify 侧对令牌做了来源 IP 白名单（只能绑定一个出口 IP），
#   服务器出口 IP 不在白名单内时所有接口都返回 401 {"error":"Unauthorized"}
FANVERIFY_API_BASE=https://api.fanverify.cn
FANVERIFY_ACCESS_TOKEN=CHANGE_ME
FANVERIFY_API_TIMEOUT=10
# 本站额外要求的 FanVerify 等级，0 = 不额外限制（由 FanVerify 侧的 need_end_level 判断）
# ⚠ 若在 FanVerify 后台把 need_end_level 调高，"账号等级不足"会与"验证码错误"
#   返回同样的 403，两者无法区分，错误文案需要相应放宽
FANVERIFY_REQUIRED_LEVEL=0
# 扫码流程的 OTP 有效期（秒）
FANVERIFY_OTP_TTL=180

# ---------- 站点 ----------
ADMIN_USERNAME=CHANGE_ME

# Bing 网站验证
BING_SITE_VERIFICATION=

# 字节跳动验证
BYTEDANCE_VERIFY_CODE=

# 字节跳动推送 Token
BYTEDANCE_PUSH_TOKEN=

# Microsoft Clarity 项目 ID
CLARITY_PROJECT_ID=
